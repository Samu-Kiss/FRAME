# FRAME API — local dev points at `supabase start` output.
# Production: Supabase cloud project values (Railway/Fly env vars).

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `supabase start`>
STORAGE_BUCKET=frame-assets
PORT=4001
WEB_ORIGIN=http://localhost:4000
NODE_ENV=development
