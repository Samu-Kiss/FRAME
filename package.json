{
  "name": "frame",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @frame/db generate",
    "db:migrate": "pnpm --filter @frame/db migrate",
    "db:push": "pnpm --filter @frame/db push",
    "db:seed": "pnpm --filter @frame/db seed"
  },
  "devDependencies": {
    "supabase": "^2.109.1",
    "turbo": "^2.5.0"
  }
}
